{
  "name": "yazi-quest",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prepare": "husky install && chmod +x .husky/* || true",
    "postinstall": "npx playwright install --with-deps",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "commitlint": "commitlint --last",
    "lint": "eslint . --ext .ts,.tsx --quiet",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test --grep \"@smoke\"",
    "test:production": "npm run build && playwright test --config=playwright.production.config.ts",
    "prepush": "npm run lint && npm run type-check && npm test && npm run build && npm run test:smoke -- --reporter=list && npm run audit:changed",
    "audit:changed": "fallow audit --base origin/main --format json --quiet && knip --no-progress",
    "graphify:update": "graphify update .",
    "graphify:report": "graphify cluster-only ."
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "lucide-react": "^0.556.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "8.73.0",
    "@typescript-eslint/parser": "8.73.0",
    "@vitejs/plugin-react": "5.1.2",
    "@vitest/coverage-v8": "4.1.12",
    "autoprefixer": "^10.7.0",
    "eslint": "9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-security": "3.0.1",
    "fallow": "^3.46.0",
    "fast-check": "^4.11.0",
    "globals": "^17.0.0",
    "husky": "9.1.7",
    "jsdom": "^27.4.0",
    "knip": "^6.48.0",
    "lint-staged": "16.2.7",
    "postcss": "^8.5.33",
    "prettier": "3.7.4",
    "tailwindcss": "^3.4.19",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}

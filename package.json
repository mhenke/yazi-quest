{
  "name": "yazi-quest",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25 || >=26.0.0"
  },
  "scripts": {
    "prepare": "husky install && chmod +x .husky/* || true",
    "postinstall": "npx playwright install --with-deps",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "commitlint": "commitlint --last",
    "lint": "eslint . --ext .ts,.tsx --quiet",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test --grep \"@smoke\"",
    "test:production": "npm run build && playwright test --config=playwright.production.config.ts",
    "prepush": "npm run lint && npm run type-check && npm test && npm run build && npm run test:smoke -- --reporter=list && npm run audit:changed",
    "audit:changed": "fallow audit --base origin/main --format compact --quiet && knip --no-progress && knip --no-progress --production",
    "audit:health": "npm run test:coverage && fallow health --coverage coverage/coverage-final.json",
    "graphify:update": "graphify update .",
    "graphify:report": "graphify cluster-only ."
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "lucide-react": "^1.81.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "25.9.12",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "8.74.0",
    "@typescript-eslint/parser": "8.74.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.2",
    "eslint": "9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-security": "4.2.1",
    "fallow": "^3.49.0",
    "fast-check": "^4.11.0",
    "globals": "^17.14.0",
    "husky": "9.1.7",
    "jsdom": "^31.0.1",
    "knip": "^6.48.0",
    "lint-staged": "17.6.2",
    "prettier": "3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "6.0.3",
    "vite": "8.4.0",
    "vitest": "5.1.2"
  }
}
